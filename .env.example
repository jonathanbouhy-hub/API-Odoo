# Exemple uniquement. Stocker les vraies valeurs dans le gestionnaire de secrets
# de l'hébergeur. Ne jamais committer un fichier contenant des identifiants.
ODOO_URL=https://odooo.elneo.com
ODOO_DB=
ODOO_LOGIN=
ODOO_API_KEY=
# Clé aléatoire distincte de la clé Odoo, utilisée par les Actions ChatGPT.
CONNECTOR_API_KEY=
# Facultatif : modèles métier supplémentaires séparés par des virgules.
ODOO_EXTRA_READ_MODELS=
